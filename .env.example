# Nusxa oling: cp .env.example .env  (Windows: copy .env.example .env) va qiymatlarni to'ldiring.
# .env faylini GitHub'ga YUKLAMANG (.gitignore da bor).

# Ustoz paroli (login: ustoz). Faqat ustoz hali yaratilmagan (bo'sh) bazada ishlatiladi.
# Bo'sh qoldirsangiz, birinchi ishga tushishda tasodifiy parol terminalga chiqariladi.
TEACHER_PASSWORD=

# Baza fayli joyi (ixtiyoriy). Sukut: data/nazorat.db
NAZORAT_DB=

# Sayt HTTPS (domen + SSL) orqali ishlasa 1 qiling: sessiya cookie faqat shifrlangan ulanishda yuboriladi.
COOKIE_SECURE=0

# Faqat scripts/import_data.py uchun: o'quvchi parollari login + shu tuzdan hosil qilinadi. Uzun tasodifiy matn bo'lsin.
PASSWORD_SALT=
