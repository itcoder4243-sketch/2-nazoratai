# /etc/systemd/system/nazoratai.service
[Unit]
Description=NazoratAI - onlayn nazorat ishi tizimi
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/nazoratai
EnvironmentFile=-/opt/nazoratai/.env
ExecStart=/opt/nazoratai/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000 --workers 4 --proxy-headers --forwarded-allow-ips=127.0.0.1 --timeout-keep-alive 30
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
